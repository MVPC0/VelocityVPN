{
  "manifest_version": 3,
  "name": "VelocityVPN — Browser Proxy",
  "version": "1.1.0",
  "description": "Route Chrome traffic through your own HTTP, HTTPS or SOCKS5 proxy server.",
  "permissions": [
    "storage",
    "proxy"
  ],
  "host_permissions": [
    "https://ipapi.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
